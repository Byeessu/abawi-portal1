{
  "name": "abawi-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "sync": "node scripts/sync-abawi-folder.mjs",
    "sync:podcasts": "node scripts/sync-podcast-audio.mjs",
    "audio:regen": "node scripts/regenerate-all-audio.mjs",
    "store:enrich": "node scripts/enrich-store-products.mjs",
    "store:enrich:all": "node scripts/enrich-store-products.mjs --all",
    "summaries": "node scripts/generate-all-summaries.mjs",
    "summaries:all": "node scripts/generate-all-summaries.mjs 70",
    "icons": "node scripts/generate-icons.mjs",
    "audio:audit": "node scripts/audit-audio.mjs",
    "audio:fix": "node scripts/audit-audio.mjs && node scripts/regenerate-all-audio.mjs",
    "deploy": "npm run sync && npm run sync:podcasts && npx vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@sentry/react": "^8.55.1",
    "@supabase/supabase-js": "^2.102.1",
    "@tiptap/extension-character-count": "^2.1.13",
    "@tiptap/extension-color": "^2.1.13",
    "@tiptap/extension-image": "^2.1.13",
    "@tiptap/extension-link": "^2.1.13",
    "@tiptap/extension-placeholder": "^2.1.13",
    "@tiptap/extension-table": "^2.1.13",
    "@tiptap/extension-table-cell": "^2.1.13",
    "@tiptap/extension-table-header": "^2.1.13",
    "@tiptap/extension-table-row": "^2.1.13",
    "@tiptap/extension-text-align": "^2.1.13",
    "@tiptap/extension-text-style": "^2.1.13",
    "@tiptap/extension-underline": "^2.1.13",
    "@tiptap/react": "^2.1.13",
    "@tiptap/starter-kit": "^2.1.13",
    "axios": "^1.15.2",
    "chart.js": "^4.5.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "idb-keyval": "^6.2.2",
    "leaflet": "^1.9.4",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.14.0",
    "swiper": "^12.1.3",
    "web-push": "^3.6.7",
    "web-vitals": "^4.2.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "jsdom": "^29.1.0",
    "netlify-cli": "^24.11.1",
    "puppeteer": "^24.43.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.4",
    "vitest": "^4.1.5"
  }
}
