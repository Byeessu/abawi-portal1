# ── Sécurité : variables SERVER-SIDE à ajouter dans Netlify Dashboard ─────────
# Ne jamais mettre dans .env public ni dans netlify.toml
AUTO_NEWS_PAUSED=false          # Mettre "true" pour suspendre le bot news sans le supprimer
PAYDUNYA_MASTER_KEY=           # Clé Master PayDunya (SERVER-SIDE UNIQUEMENT)
PAYDUNYA_PRIVATE_KEY=          # Clé Private PayDunya (SERVER-SIDE UNIQUEMENT)
PAYDUNYA_TOKEN=                # Token PayDunya (SERVER-SIDE UNIQUEMENT)
PAYDUNYA_MODE=live             # live ou sandbox
PAYDUNYA_IPN_SECRET=           # Secret aléatoire (32+ chars) — à ajouter à l'URL IPN PayDunya: ?ipn_secret=XXX

# ── Mobile Money & Transferts (SERVER-SIDE UNIQUEMENT) ────────────────────────
WAVE_API_KEY=                  # Clé API Wave (SERVER-SIDE UNIQUEMENT)
OM_API_KEY=                    # Clé API Orange Money (SERVER-SIDE UNIQUEMENT)
FYATU_API_KEY=                 # Clé API Fyatu (SERVER-SIDE UNIQUEMENT)
ONAFRIQ_API_KEY=               # Clé API Onafriq (SERVER-SIDE UNIQUEMENT)
PAYMENTOLOGY_API_KEY=          # Clé API Paymentology (SERVER-SIDE UNIQUEMENT)
# ──────────────────────────────────────────────────────────────────────────────

SOCIAL_OPS_SECRET=             # Secret interne pour social-queue-admin (32+ chars)
SUPABASE_ANON_KEY=             # Clé anon Supabase (pour netlify functions sans service role)
SUPABASE_SERVICE_ROLE_KEY=     # Clé service role Supabase (server-side uniquement — NE PAS exposer)
# ──────────────────────────────────────────────────────────────────────────────

VITE_GROQ_API_KEY=
VITE_GROK_LLAMA_API_KEY=
VITE_GROQ_BASE_URL=https://api.groq.com/openai/v1
VITE_GROQ_MODEL=llama-3.3-70b-versatile
# Recommended server-side key for Netlify groq proxy
GROQ_API_KEY=
# Optional browser fallback only (prefer server key below)
VITE_ELEVENLABS_API_KEY=
# Recommended for Netlify functions (secure server-side proxy)
ELEVENLABS_API_KEY=

# Microsoft Azure Speech (TTS neural FR — netlify/functions/azure-tts.js)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Polotno — https://polotno.com/cabinet/ (page Studio visuel)
VITE_POLOTNO_API_KEY=

# --- Observability (src/lib/observability.js) ---
# Sentry — errors, session replay, perf tracing. Empty = disabled.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_RELEASE=
# Set VITE_SENTRY_ALLOW_DEV=1 to forward errors from local dev to Sentry
VITE_SENTRY_ALLOW_DEV=

# Plausible — privacy-friendly analytics + Web Vitals dashboard. Empty = disabled.
# Domain registered in Plausible (e.g. abawi.sn or abawi.app)
VITE_PLAUSIBLE_DOMAIN=
# Override only if self-hosting Plausible
VITE_PLAUSIBLE_HOST=https://plausible.io
